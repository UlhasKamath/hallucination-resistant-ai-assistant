# LangSmith
LANGCHAIN_API_KEY="LANGSMITH_API_KEY"
LANGCHAIN_PROJECT="hybrid-rag-advanced"

# Models (Ollama model names)
LLM_MODEL=qwen2.5:3b
CLASSIFIER_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# Set to true to enable multi-query expansion in RAG (slower but higher recall)
EXPAND_QUERIES=false

# Redis (default: localhost:6379, change if using Docker)
# If Redis is running in Docker, set REDIS_HOST to your container host
REDIS_HOST=localhost
REDIS_PORT=6379

TAVILY_API_KEY="TAVILY_API_KEY"